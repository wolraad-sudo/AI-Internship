OPENAI_API_KEY=

# Session 2 - Pinecone vector store
PINECONE_API_KEY=
# Optional (defaults shown)
PINECONE_INDEX_NAME=session2-rag
PINECONE_NAMESPACE=default
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Chunking for /ingest (optional, defaults shown)
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# Reranking (optional, defaults shown)
RERANK_MODEL=bge-reranker-v2-m3
RERANK_CANDIDATES=20

OPENAI_API_KEY=

# Session 2 - Pinecone vector store
PINECONE_API_KEY=
# Optional (defaults shown)
PINECONE_INDEX_NAME=session2-rag
PINECONE_NAMESPACE=default
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Chunking for /ingest (optional, defaults shown)
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# Reranking (optional, defaults shown)
RERANK_MODEL=bge-reranker-v2-m3
RERANK_CANDIDATES=20

# Session 3 - Google ADK agent (POST /agent, run_cdd_agent.py)
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=FALSE
# Optional: Gemini model for the agent (default gemini-3.5-flash)
# CDD_AGENT_MODEL=gemini-3.5-flash
